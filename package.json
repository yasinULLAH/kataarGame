{
  "name": "kataargame",
  "version": "1.0.0",
  "private": true,
  "description": "Katar & Navakankari — Royal Board Game. Copyright © 2026 Yasin Ullah. All rights reserved.",
  "main": "main.js",
  "scripts": {
    "prepare-www": "node prepare-www.js",
    "build": "node prepare-www.js && cap sync android",
    "start": "electron .",
    "dist:win": "node prepare-www.js && electron-builder --win portable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasinULLAH/kataarGame.git"
  },
  "author": {
    "name": "Yasin Ullah",
    "url": "https://github.com/yasinULLAH/kataarGame"
  },
  "copyright": "Copyright © 2026 Yasin Ullah. All rights reserved.",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.yasin.katargame",
    "productName": "Katar Game",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon-512.png"
    },
    "portable": {
      "artifactName": "Katar-Game-Portable.exe"
    },
    "files": [
      "main.js",
      "www/**/*",
      "icon-512.png"
    ]
  }
}
